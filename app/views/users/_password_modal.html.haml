- force_set_password ||= false

= turbo_frame_tag 'password-modal' do
  .we-modal-overlay{ data: { controller: 'modal' } }
    .we-modal-backdrop{ data: { action: 'click->modal#close' } }
    .we-modal-dialog{ role: 'dialog', 'aria-modal': 'true' }
      .we-modal-card
        .we-modal-header
          %h5.we-modal-title
            = force_set_password ? 'Set password' : 'Change password'
          %button.we-modal-close{ type: 'button', data: { action: 'click->modal#close' } } ×

        = simple_form_for(@item,
                          url: update_password_user_path(@item),
                          method: :patch,
                          html: { novalidate: true, autocomplete: 'off' },
                          data: { turbo_frame: 'password-modal' }) do |f|
          = hidden_field_tag :force_set_password, (force_set_password ? "1" : "0")

          .we-modal-body
            -# 🔐 Current password only when changing your own password
            - if !force_set_password && current_user.id == @item.id && !current_user.admin?
              = f.input :current_password,
                        as: :password,
                        label: 'Current password',
                        input_html: { autocomplete: 'current-password' }

            = f.input :password,
                      as: :password,
                      label: force_set_password ? 'Set password' : 'New password',
                      required: true,
                      input_html: { autocomplete: 'new-password' }

            = f.input :password_confirmation,
                      as: :password,
                      label: 'Confirm password',
                      required: true,
                      input_html: { autocomplete: 'new-password' }

          .we-modal-footer
            %button.btn.btn-light{ type: 'button', data: { action: 'click->modal#close' } } Cancel
            %button.btn.btn-primary{ type: 'submit' }
              = force_set_password ? 'Set password' : 'Update password'
