= render partial: 'modal', locals: {title: 'Add Users to Organisation',
  id: 'add_to_organisation',
  body_partial: 'users/add_to_organisation_modal',
  body_locals: { selected_ids: '', parent: @parent, organisations: Organisation.order(:name) }}