- if notice
  .row
    .alert.alert-info{ role: "alert",
                       data: { controller: "auto-dismiss", "auto-dismiss-ms-value": 4000 } }= notice

- if alert
  .row
    .alert.alert-danger{ role: "alert",
                          data: { controller: "auto-dismiss", "auto-dismiss-ms-value": 7000 } }= alert
