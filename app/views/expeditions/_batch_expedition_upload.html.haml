= form_tag batch_upload_expeditions_path, local: true, multipart: true, method: :post do
  .form-inputs
    .row
      .col-md-6
        = label_tag 'file', 'Expedition File:'
        = file_field_tag 'file', required: true
  .form-actions.float-end
    = submit_tag 'Upload', class: 'btn btn-primary btn-sm'
